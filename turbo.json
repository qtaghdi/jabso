{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "HOST",
    "JABSO_ADMIN_TOKEN",
    "JABSO_ALLOWED_ORIGIN",
    "JABSO_BOUNDRA_DIAGNOSTIC_PATH",
    "JABSO_DATABASE_URL",
    "JABSO_DASHBOARD_TOKEN",
    "JABSO_GITHUB_APP_CLIENT_ID",
    "JABSO_GITHUB_APP_CLIENT_SECRET",
    "JABSO_GITHUB_APP_ID",
    "JABSO_GITHUB_APP_PRIVATE_KEY_BASE64",
    "JABSO_GITHUB_APP_SLUG",
    "JABSO_GITHUB_APP_WEBHOOK_SECRET",
    "PORT",
    "POSTGRES_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "@jabso/db#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "passThroughEnv": ["DATABASE_URL", "JABSO_DATABASE_URL", "POSTGRES_URL"]
    },
    "@jabso/diagnostics#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "passThroughEnv": ["JABSO_BOUNDRA_DIAGNOSTIC_PATH"]
    },
    "@jabso/server#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "passThroughEnv": [
        "DATABASE_URL",
        "HOST",
        "JABSO_ADMIN_TOKEN",
        "JABSO_ALLOWED_ORIGIN",
        "JABSO_BOUNDRA_DIAGNOSTIC_PATH",
        "JABSO_DATABASE_URL",
        "JABSO_DASHBOARD_TOKEN",
        "JABSO_GITHUB_APP_CLIENT_ID",
        "JABSO_GITHUB_APP_CLIENT_SECRET",
        "JABSO_GITHUB_APP_ID",
        "JABSO_GITHUB_APP_PRIVATE_KEY_BASE64",
        "JABSO_GITHUB_APP_SLUG",
        "JABSO_GITHUB_APP_WEBHOOK_SECRET",
        "PORT",
        "POSTGRES_URL"
      ]
    },
    "@jabso/web#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_TRUSTED_ORIGINS",
        "BETTER_AUTH_URL",
        "JABSO_API_URL",
        "JABSO_AUTH_EMAIL_FROM",
        "JABSO_DATABASE_URL",
        "JABSO_DASHBOARD_TOKEN",
        "JABSO_GITHUB_OAUTH_CLIENT_ID",
        "JABSO_GITHUB_OAUTH_CLIENT_SECRET",
        "JABSO_PROJECT_ID",
        "JABSO_PROJECT_KEY",
        "NEXT_PUBLIC_APP_VERSION",
        "NEXT_PUBLIC_JABSO_DSN",
        "RESEND_API_KEY"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "db:generate": {
      "cache": false
    }
  }
}
