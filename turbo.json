{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "@jabso/db#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "passThroughEnv": ["DATABASE_URL", "JABSO_DATABASE_URL", "POSTGRES_URL"]
    },
    "@jabso/diagnostics#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "passThroughEnv": ["JABSO_BOUNDRA_DIAGNOSTIC_PATH"]
    },
    "@jabso/server#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "passThroughEnv": [
        "DATABASE_URL",
        "JABSO_ADMIN_TOKEN",
        "JABSO_ALLOWED_ORIGIN",
        "JABSO_BOUNDRA_DIAGNOSTIC_PATH",
        "JABSO_DATABASE_URL",
        "POSTGRES_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "db:generate": {
      "cache": false
    }
  }
}
