{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "@jabso/db#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "passThroughEnv": ["DATABASE_URL", "JABSO_DATABASE_URL", "POSTGRES_URL"]
    },
    "@jabso/diagnostics#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "passThroughEnv": ["JABSO_BOUNDRA_DIAGNOSTIC_PATH"]
    },
    "@jabso/server#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "passThroughEnv": [
        "DATABASE_URL",
        "HOST",
        "JABSO_ADMIN_TOKEN",
        "JABSO_ALLOWED_ORIGIN",
        "JABSO_BOUNDRA_DIAGNOSTIC_PATH",
        "JABSO_DATABASE_URL",
        "JABSO_DASHBOARD_TOKEN",
        "PORT",
        "POSTGRES_URL"
      ]
    },
    "@jabso/web#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "CLERK_SECRET_KEY",
        "JABSO_API_URL",
        "JABSO_DASHBOARD_TOKEN",
        "JABSO_PROJECT_ID",
        "JABSO_PROJECT_KEY",
        "NEXT_PUBLIC_APP_VERSION",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_CLERK_SIGN_IN_URL",
        "NEXT_PUBLIC_CLERK_SIGN_UP_URL",
        "NEXT_PUBLIC_JABSO_DSN"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "db:generate": {
      "cache": false
    }
  }
}
