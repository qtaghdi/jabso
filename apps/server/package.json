{
  "name": "@jabso/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --sourcemap --clean",
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "start": "dotenv -e ../../.env -- node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@jabso/db": "workspace:*",
    "@jabso/diagnostics": "workspace:*",
    "@jabso/sentry-compat": "workspace:*",
    "@jabso/symbolication": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "boundra": "0.3.0",
    "fastify": "5.12.1",
    "openapi-types": "12.1.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.5",
    "@types/node": "24.13.3",
    "dotenv-cli": "11.0.0",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
